    { "min": [2560, -768, 0], "max": [2576, -736, 8], "material": "block" },
    { "min": [3072, -768, 0], "max": [3088, -736, 16], "material": "block" },
    { "min": [3584, -768, 0], "max": [3600, -736, 8], "material": "block" },

    // stairs up: 8 steps of 16 units, 32 deep, then a landing at 128
    { "min": [0, 64, 0], "max": [256, 320, 16], "material": "block" },
    { "min": [32, 64, 16], "max": [256, 320, 32], "material": "block" },
